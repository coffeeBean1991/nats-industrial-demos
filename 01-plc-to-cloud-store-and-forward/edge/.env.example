# Edge device stack configuration. Copy to .env and adjust.

# CODESYS OPC UA server on the Windows machine (the plant)
OPCUA_ENDPOINT=opc.tcp://<windows-ip>:4840

# Gateway NATS leaf node port, as seen from this device.
#   All stacks on one Mac:      nats://host.docker.internal:7423
#   Gateway on its own device:  nats://<gateway-ip>:7422
GATEWAY_LEAF_URL=nats://host.docker.internal:7423

# Gateway Fluent Bit (metrics relay), as seen from this device.
#   All stacks on one Mac:      host.docker.internal / 24225
#   Gateway on its own device:  <gateway-ip> / 24224
GATEWAY_FLUENTBIT_HOST=host.docker.internal
GATEWAY_FLUENTBIT_PORT=24225

# Host ports for this stack (defaults; change only if they clash)
EDGE_NATS_PORT=4222
EDGE_MONITOR_PORT=8222
