# Hub stack configuration. Copy to .env and adjust.
# Demo credentials only: change them if this ever runs anywhere shared.

# Host ports. The NATS and Fluent Bit ports avoid clashing with the edge and
# gateway when all stacks run on one Mac.
HUB_NATS_PORT=4224
HUB_LEAF_PORT=7424
HUB_MONITOR_PORT=8224
HUB_FLUENTBIT_PORT=24226
INFLUX_PORT=8086
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# InfluxDB (initialised on first start)
INFLUX_USER=admin
INFLUX_PASSWORD=admin12345
INFLUX_ORG=plant-demo
INFLUX_BUCKET=plant
INFLUX_TOKEN=demo-token-change-me

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
