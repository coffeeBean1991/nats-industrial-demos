# Gateway stack configuration. Copy to .env and adjust.

# Hub NATS leaf node port, as seen from this device.
#   All stacks on one Mac:      nats://host.docker.internal:7424
#   Hub on its own machine:     nats://<hub-ip>:7422
HUB_LEAF_URL=nats://host.docker.internal:7424

# Hub Fluent Bit (metrics relay), as seen from this device.
#   All stacks on one Mac:      host.docker.internal / 24226
#   Hub on its own machine:     <hub-ip> / 24224
HUB_FLUENTBIT_HOST=host.docker.internal
HUB_FLUENTBIT_PORT=24226

# Host ports for this stack. These avoid clashing with the edge and hub
# when all stacks run on one Mac. On a Raspberry Pi, use the defaults:
# 4222, 7422, 8222 and 24224.
GATEWAY_NATS_PORT=4223
GATEWAY_LEAF_PORT=7423
GATEWAY_MONITOR_PORT=8223
GATEWAY_FLUENTBIT_PORT=24225
